# Copy outside version control; supply unique secrets through your deployment system.
SPRING_PROFILES_ACTIVE=mariadb
LIBREPM_DB_URL=jdbc:mariadb://db.internal.example:3306/librepm?sslMode=verify-full
LIBREPM_DB_USERNAME=librepm
LIBREPM_DB_PASSWORD=CHANGE_ME
LIBREPM_SERVER_ADDRESS=127.0.0.1
LIBREPM_SERVER_PORT=8080
LIBREPM_DATA_PATH=/var/lib/librepm
# Configure OAuth2 provider before exposing backend remotely.
LIBREPM_AUTH_ENABLED=true
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_LIBREPM_CLIENT_ID=CHANGE_ME
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_LIBREPM_CLIENT_SECRET=CHANGE_ME
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_LIBREPM_AUTHORIZATION_GRANT_TYPE=authorization_code
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_LIBREPM_REDIRECT_URI={baseUrl}/login/oauth2/code/{registrationId}
SPRING_SECURITY_OAUTH2_CLIENT_PROVIDER_LIBREPM_ISSUER_URI=https://identity.example/realms/librepm
